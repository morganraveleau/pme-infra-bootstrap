---
# Copier ce fichier en all.yml (ignoré par git) et remplir toutes les valeurs.
# Les secrets (mots de passe) peuvent être chiffrés avec ansible-vault :
#   ansible-vault encrypt_string 'MonMotDePasse!' --name 'vault_windows_admin_password'

company_name: "acme"

# ── k3s / applicatif ─────────────────────────────────────────────────────────
webapp_domain: "app.acme.lab"
webapp_enable_monitoring: true
postgres_db_name: "acme_app"
postgres_admin_password: "CHANGE-ME"

# ── Active Directory ──────────────────────────────────────────────────────────
ad_domain_name: "acme.lab"
ad_domain_netbios_name: "ACME"
ad_safe_mode_admin_password: "CHANGE-ME"   # DSRM — complexité Windows requise

# Mot de passe du compte Administrator Windows (utilisé par Ansible via WinRM)
# Doit correspondre au mot de passe défini dans packer/windows-server-2022.pkrvars.hcl
vault_windows_admin_password: "CHANGE-ME"

# Surcharger les utilisateurs AD créés par défaut (optionnel — voir role defaults)
# ad_users:
#   - firstname: "Jean"
#     lastname: "Dupont"
#     username: "jean.dupont"
#     password: "{{ vault_jean_dupont_password }}"
#     ou: "Utilisateurs"
#     groups: ["GRP-Utilisateurs"]
#     description: "Commercial"
#     password_never_expires: false

# ── Monitoring ────────────────────────────────────────────────────────────────
grafana_admin_password: "CHANGE-ME"
prometheus_retention: "6h"   # augmenter à 15j+ quand la RAM le permet
